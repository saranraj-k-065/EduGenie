import os
# Copy this file to .env and add your Google AI Studio Gemini API key.
GEMINI_API_KEY=your_gemini_api_key_here
# Change this to a Gemini model available to your API key/project.
GEMINI_MODEL=gemini-3.1-flash-lite

# Optional local LaMini-Flan-T5 explainer. First install transformers and torch.
USE_LOCAL_EXPLAINER=false
LOCAL_EXPLAINER_MODEL=MBZUAI/LaMini-Flan-T5-783M
